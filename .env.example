# ==============================================================================
# FLOWMIND AI — ENVIRONMENT CONFIGURATION TEMPLATE
#
# SECURITY ARCHITECTURE:
# 1. CLIENT-SAFE: Variables prefixed with "VITE_" are bundled into browser JS.
#    Only place public / anon keys here.
# 2. SERVER-ONLY: Variables WITHOUT "VITE_" are strictly accessible only by the
#    Node / Render server backend. NEVER prefix Render or AI secrets with "VITE_".
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SAFE CREDENTIALS (Vite Frontend)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY: RENDER WORKFLOWS ENGINE (NEVER prefix with VITE_)
# Obtain from: https://dashboard.render.com -> Account Settings -> API Keys
# ------------------------------------------------------------------------------
RENDER_API_KEY=rnd_your_render_api_key_here
RENDER_WORKFLOW_SLUG=flowmind-workflows
RENDER_TASKS_URL=https://api.render.com/v1
# RENDER_WORKSPACE_ID=tea-your-workspace-id  # Optional: For scoped team/workspace tasks
# RENDER_LOCAL_DEV=false                     # Set to true when running local task runner

# ------------------------------------------------------------------------------
# 3. SERVER-ONLY: AI REASONING COPILOT (NEVER prefix with VITE_)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 4. SERVER RUNTIME
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
